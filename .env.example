DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL_DIRECT=postgresql+psycopg://user:password@host/dbname?sslmode=require
REDIS_URL=redis://localhost:6379/0

COMETAPI_API_KEY=your_cometapi_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback

# Gemini API — get key from https://aistudio.google.com
# Must have the Gemini API enabled in your Google Cloud project
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-3.1-pro-preview for deep analysis, gemini-3.1-flash-lite-preview for speed
GEMINI_MODEL=gemini-3.1-pro-preview

SECRET_KEY=generate_with_openssl_rand_hex_32

CLAUDE_CREATIVE_MODEL=claude-opus-4-6
CLAUDE_FAST_MODEL=claude-sonnet-4-6
DEFAULT_IMAGE_MODEL=nanobananapro
DEFAULT_VIDEO_MODEL=kling3
JOB_FILES_DIR=./jobs
CELERY_CONCURRENCY=8

# --- Higgsfield: the primary generator ---
# Setup, once per machine:
#   npm i -g @higgsfield/cli
#   higgsfield auth login          (opens a browser; the CLI refreshes the token after)
# When Higgsfield is unavailable or a call fails, generation falls back to CometAPI.
HIGGSFIELD_ENABLED=true
HIGGSFIELD_CLI=higgsfield
# Higgsfield model ids use UNDERSCORES. They are not the CometAPI names:
#   seedance_2_5   not  doubao-seedance-2-5
#   minimax_h3     not  minimax-h3
# Run `higgsfield model list --video --json` to see what your account can reach.
HIGGSFIELD_IMAGE_MODEL=seedream_v5_pro
HIGGSFIELD_REFERENCE_IMAGE_MODEL=nano_banana_2
HIGGSFIELD_VIDEO_MODEL=seedance_2_5
# seedance_2_5 refuses a request with no size: "Missing required params: height, width".
# 1280x720 is 16:9. Sent only to models that declare width and height.
HIGGSFIELD_VIDEO_WIDTH=1280
HIGGSFIELD_VIDEO_HEIGHT=720

# --- Reference-anchored image generation (OpenAI) — second in line ---
# Set this to turn on character consistency. With a key, a scene whose character or
# environment carries a reference picture is generated from that picture instead of
# from a prose description. Leave it empty and every scene uses the CometAPI text path.
OPENAI_API_KEY=
# Model id for the OpenAI images endpoints. Change it here if your account uses a
# different one — the app never hardcodes the name.
OPENAI_IMAGE_MODEL=gpt-image-2
# Picture quality: low | medium | high | auto.
# Measured live: "high" took 112 seconds for one picture. "medium" is the default
# because scene stills are only the input to the video model, which resamples them.
OPENAI_IMAGE_QUALITY=medium

# --- Ported from neural-frames review (optional feature services) ---
STEM_SEPARATION_ENABLED=false
UPSCALING_ENABLED=false

# --- Job execution ---
# true  = the web server runs the job itself (simple, but a restart loses the job)
# false = only `python -m worker` runs jobs (survives restarts)
RUN_JOBS_INLINE=true

# --- Supabase Storage ---
# Two buckets on purpose. The audio bucket restricts mime types to audio, so reference
# sheets and image-board uploads (PNG) are refused there with 415 invalid_mime_type.
SUPABASE_AUDIO_BUCKET=production-audio
SUPABASE_ASSET_BUCKET=production-assets
